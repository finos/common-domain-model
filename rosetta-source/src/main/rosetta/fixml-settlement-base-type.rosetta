namespace cdm.fixml.settlement.base : < "test" >
version "${project.version}"

import cdm.fixml.components.base.*
import cdm.fixml.fields.base.*
import cdm.fixml.fields.impl.*

type SettlInstrctns extends SettlementInstructions_message_t:

type SettlInstrctnReq extends SettlementInstructionRequest_message_t:

type SettlObligation extends SettlementObligationReport_message_t:

type SettlementInstructions_message_t extends Abstract_message_t: <"SettlementInstructions can be found in Volume 5 of the \t\t\t\t\t\tspecification">

    settlInstMsgID SettlInstMsgID_t (1..1)
    settlInstReqID SettlInstReqID_t (0..1)
    settlInstMode SettlInstMode_t (1..1)
    settlInstReqRejCode SettlInstReqRejCode_t (0..1)
    txt Text_t (0..1)
    encTxtLen EncodedTextLen_t (0..1)
    encTxt EncodedText_t (0..1)
    clOrdID ClOrdID_t (0..1)
    txnTm TransactTime_t (1..1)
    setInst SettlInstGrp_Block_t (0..*)

type SettlementInstructionRequest_message_t extends Abstract_message_t: <"SettlementInstructionRequest can be found in Volume 5 of the \t\t\t\t\t\tspecification">

    settlInstReqID SettlInstReqID_t (1..1)
    txnTm TransactTime_t (1..1)
    acct AllocAccount_t (0..1)
    actIDSrc AllocAcctIDSource_t (0..1)
    side Side_t (0..1)
    prod Product_t (0..1)
    secTyp SecurityType_t (0..1)
    cfi CFICode_t (0..1)
    settlCcy SettlCurrency_t (0..1)
    efctvTm EffectiveTime_t (0..1)
    expireTm ExpireTime_t (0..1)
    lastUpdateTm LastUpdateTime_t (0..1)
    standInstDbTyp StandInstDbType_t (0..1)
    standInstDbName StandInstDbName_t (0..1)
    standInstDbID StandInstDbID_t (0..1)
    pty Parties_Block_t (0..*)

type SettlementObligationReport_message_t extends Abstract_message_t: <"SettlementObligationReport can be found in Volume 5 of the \t\t\t\t\t\tspecification">

    bizDt ClearingBusinessDate_t (0..1)
    cycleNo SettlementCycleNo_t (0..1)
    settlMsgID SettlObligMsgID_t (1..1)
    settlMode SettlObligMode_t (1..1)
    txt Text_t (0..1)
    encTxtLen EncodedTextLen_t (0..1)
    encTxt EncodedText_t (0..1)
    txnTm TransactTime_t (0..1)
    applSeqCtrl ApplicationSequenceControl_Block_t (0..1)
    settlObligInst SettlObligationInstructions_Block_t (1..*)

type SettlInstGrp_Block_t:

    settlInstID SettlInstID_t (0..1)
    settlInstTransTyp SettlInstTransType_t (0..1)
    settlInstRefID SettlInstRefID_t (0..1)
    side Side_t (0..1)
    prod Product_t (0..1)
    secTyp SecurityType_t (0..1)
    cfi CFICode_t (0..1)
    settlCcy SettlCurrency_t (0..1)
    efctvTm EffectiveTime_t (0..1)
    expireTm ExpireTime_t (0..1)
    lastUpdateTm LastUpdateTime_t (0..1)
    pmtMethod PaymentMethod_t (0..1)
    pmtRef PaymentRef_t (0..1)
    cardHolderName CardHolderName_t (0..1)
    cardNum CardNumber_t (0..1)
    cardStartDt CardStartDate_t (0..1)
    cardExpDt CardExpDate_t (0..1)
    cardIssNum CardIssNum_t (0..1)
    pmtDt PaymentDate_t (0..1)
    pmtRemtrID PaymentRemitterID_t (0..1)
    pty Parties_Block_t (0..*)
    setInstr SettlInstructionsData_Block_t (0..1)

type SettlObligationInstructions_Block_t:

    netGrossInd NetGrossInd_t (0..1)
    settlID SettlObligID_t (0..1)
    settlTransTyp SettlObligTransType_t (0..1)
    settlRefID SettlObligRefID_t (0..1)
    ccyAmt CcyAmt_t (0..1)
    settlCurrAmt SettlCurrAmt_t (0..1)
    ccy Currency_t (0..1)
    settlCcy SettlCurrency_t (0..1)
    settlCurrFxRt SettlCurrFxRate_t (0..1)
    settlDt SettlDate_t (0..1)
    efctvTm EffectiveTime_t (0..1)
    expireTm ExpireTime_t (0..1)
    lastUpdateTm LastUpdateTime_t (0..1)
    instrmt Instrument_Block_t (0..1)
    pty Parties_Block_t (0..*)
    settlDetails SettlDetails_Block_t (0..*)
