namespace cdm.product.common.settlement : <"Common product settlement concepts: cash vs physical, non-deliverable, money and cashflow, delivery vs payment.">
version "${project.version}"

import cdm.base.datetime.*
import cdm.base.math.*
import cdm.observable.asset.*

func UpdateAmountForEachMatchingQuantity: <"Updates any price or quantity from the list of PriceQuantity if the unit of amount matches.">
    inputs:
        priceQuantityList PriceQuantity (1..*) <"List of PriceQuantity to update.">
        change PriceQuantity (1..*) <"List of new PriceQuantity to use where the units match.">
        direction QuantityChangeDirectionEnum (1..1) <"Enum specifying how the updated amounts should be applied, e.g., add, subtract or replace.">
    output:
        updatedPriceQuantity PriceQuantity (1..*) <"List of PriceQuantity with the price and quantity amounts updated.">

    add updatedPriceQuantity: <"For each PriceQuantity, update the price and quantity amounts.">
        priceQuantityList
            extract priceQuantity [
                PriceQuantity {
                    price: priceQuantity -> price
                            extract
                                RescaleDerivedQuantity(
                                        item,
                                        UpdatePriceAmountForEachMatchingQuantity(
                                                item,
                                                change,
                                                direction
                                            ),
                                        UpdateQuantityAmountForEachMatchingQuantity(
                                                priceQuantity -> quantity,
                                                change,
                                                direction
                                            )
                                    ),
                    quantity: priceQuantity -> quantity
                            extract
                                UpdateQuantityAmountForEachMatchingQuantity(
                                        item,
                                        change, // FilterChangePriceQuantity(priceQuantity, change),
                                        // PriceQuantity used as input to keep the quantity and effectiveDate linked
                                        direction
                                    ),
                    observable: priceQuantity -> observable,
                    effectiveDate: priceQuantity -> effectiveDate
                }
            ]

func RescaleDerivedQuantity: <"Keeps price.derivedQuantity consistent with its sibling quantity after a QuantityChange across both scalar values and step schedules (datedValue). Rescales derivedQuantity.value and derivedQuantity.datedValue to effective siblingQuantity * updatedPrice only when derivedQuantity is populated, updatedPrice.perUnitOf matches the sibling quantity's unit, AND the price itself (both value and datedValue schedule) did not change (e.g. an equity partial termination or scheduled quantity step change that only adjusts the quantity). When the price also changed - as in a stock split, where quantity and price both scale by inverse factors so total notional is preserved by construction - the existing derivedQuantity is retained. Prices without derivedQuantity, or where perUnitOf does not match the sibling unit (e.g. spread on an interest-rate payout, or currency-only PriceQuantity rows), are returned unchanged.">
    inputs:
        originalPrice PriceSchedule (0..1)
        updatedPrice PriceSchedule (0..1)
            [metadata location]
        siblingQuantity NonNegativeQuantitySchedule (0..1)
    output:
        rescaledPrice PriceSchedule (0..1)
            [metadata location]

    alias priceValueUnchanged:
        (originalPrice -> value is absent and updatedPrice -> value is absent)
            or originalPrice -> value = updatedPrice -> value

    alias priceUnchanged:
        priceValueUnchanged
            and PriceDatedValuesEqual(originalPrice -> datedValue, updatedPrice -> datedValue)

    alias shouldRescale:
        updatedPrice -> derivedQuantity exists
            and siblingQuantity exists
            and updatedPrice -> perUnitOf exists
            and UnitEquals(updatedPrice -> perUnitOf, siblingQuantity -> unit)
            and priceUnchanged

    alias effectiveQuantityValue:
        if siblingQuantity -> multiplier -> value exists
        then siblingQuantity -> value * siblingQuantity -> multiplier -> value
        else siblingQuantity -> value

    alias rescaledScalarAmount:
        if effectiveQuantityValue exists and updatedPrice -> value exists
        then effectiveQuantityValue * updatedPrice -> value

    alias scheduleDates:
        [
            updatedPrice -> derivedQuantity -> datedValue -> date,
            updatedPrice -> datedValue -> date,
            siblingQuantity -> datedValue -> date
        ]
            distinct
            then sort

    set rescaledPrice: updatedPrice
    set rescaledPrice -> derivedQuantity -> value:
        if shouldRescale and rescaledScalarAmount exists and rescaledScalarAmount >= 0
        then rescaledScalarAmount
        else updatedPrice -> derivedQuantity -> value
    set rescaledPrice -> derivedQuantity -> datedValue:
        if shouldRescale and scheduleDates exists
        then scheduleDates
                extract
                    RescaleDerivedDatedValue(
                            item,
                            updatedPrice,
                            siblingQuantity
                        )
        else updatedPrice -> derivedQuantity -> datedValue

func RescaleDerivedDatedValue: <"Computes or rescales the derivedQuantity datedValue entry for a given schedule step date using the effective sibling quantity (including multiplier when present) and effective price on or prior to that step date.">
    inputs:
        stepDate date (1..1)
        updatedPrice PriceSchedule (0..1)
        siblingQuantity NonNegativeQuantitySchedule (0..1)
    output:
        rescaledDatedValue NonNegativeDatedValue (0..1)

    alias existingDerivedDatedValue:
        updatedPrice -> derivedQuantity -> datedValue
            filter date = stepDate
            then first

    alias matchingQuantityDatedValue:
        siblingQuantity -> datedValue
            filter date <= stepDate
            then sort [ date ]
            then last

    alias matchingPriceDatedValue:
        updatedPrice -> datedValue
            filter date <= stepDate
            then sort [ date ]
            then last

    alias baseQuantityForDate:
        matchingQuantityDatedValue -> value default siblingQuantity -> value

    alias effectiveQuantityForDate:
        if siblingQuantity -> multiplier -> value exists
        then baseQuantityForDate * siblingQuantity -> multiplier -> value
        else baseQuantityForDate

    alias effectivePriceForDate:
        matchingPriceDatedValue -> value default updatedPrice -> value

    alias rescaledAmount:
        if effectiveQuantityForDate exists and effectivePriceForDate exists
        then effectiveQuantityForDate * effectivePriceForDate

    set rescaledDatedValue:
        if rescaledAmount exists and rescaledAmount >= 0
        then if existingDerivedDatedValue exists
            then UpdateNonNegativeDatedValueAmount(existingDerivedDatedValue, rescaledAmount)
            else NonNegativeDatedValue {
                date: stepDate,
                value: rescaledAmount
            }
        else existingDerivedDatedValue

func UpdateNonNegativeDatedValueAmount: <"Updates the value of an existing NonNegativeDatedValue while preserving its date and metadata.">
    inputs:
        datedValue NonNegativeDatedValue (0..1)
        newValue number (1..1)
    output:
        updatedDatedValue NonNegativeDatedValue (0..1)

    set updatedDatedValue: datedValue
    set updatedDatedValue -> value: newValue

func PriceDatedValuesEqual: <"Checks whether two DatedValue schedules contain the same step dates and values.">
    inputs:
        d1 DatedValue (0..*)
        d2 DatedValue (0..*)
    output:
        result boolean (1..1)

    alias sameCount:
        d1 count = d2 count

    alias d1MatchesD2:
        d1 is absent
            or (d1
                extract item1 [
                    d2
                        filter date = item1 -> date and value = item1 -> value
                        then exists
                ]
                then all = True)

    alias d2MatchesD1:
        d2 is absent
            or (d2
                extract item2 [
                    d1
                        filter date = item2 -> date and value = item2 -> value
                        then exists
                ]
                then all = True)

    set result:
        sameCount and d1MatchesD2 and d2MatchesD1

// TODO uncomment usage to support matching on PriceQuantity observable
func FilterChangePriceQuantity: <"Filter the change PriceQuantity list to match on Observable if present.">
    inputs:
        priceQuantity PriceQuantity (0..1) <"List of PriceQuantity to update.">
        change PriceQuantity (0..*) <"List of new PriceQuantity to use where the units match.">
    output:
        filteredChange PriceQuantity (0..*)

    alias changeWithMatchingObservable:
        change
            filter
                // match on observable is absent
                (item -> observable is absent and priceQuantity -> observable is absent)
                        // or, match on observable
                    or item -> observable = priceQuantity -> observable

    add filteredChange: changeWithMatchingObservable default change

func UpdatePriceAmountForEachMatchingQuantity: <"Updates any price from the PriceSchedule list if the unit of amount matches.">
    inputs:
        price PriceSchedule (0..1) <"List of PriceSchedule to update.">
            [metadata location]
        change PriceQuantity (0..*) <"PriceQuantity that holds the list of new PriceSchedule to use where the units match.">
        direction QuantityChangeDirectionEnum (1..1) <"Enum specifying how the updated amounts should be applied, e.g. add, subtract or replace.">
    output:
        updatedPrice PriceSchedule (0..1)
            [metadata location]

    alias changeMatching: <"Locate the first PriceQuantity item where the attributes in the existing and the new price match.">
        change
            filter c [
                c -> price
                    extract PriceUnitEquals(item, price)
                    then only-element
            ]
            then first

    alias changeEffectiveDate: <"The effective date to use for the price update. Required when updating datedValue.">
        AdjustableDateResolution(changeMatching -> effectiveDate -> adjustableDate)

    alias containsEffectiveDate: <"Is there already an entry for the effective date of the new price?">
        price -> datedValue -> date contains changeEffectiveDate

    alias changedAmount: <"Update the value in the matched PriceSchedule. The value attribute should only be updated if an effective date for the change in price has not been provided.">
        if changeEffectiveDate is absent
        then UpdateAmount(
                    price -> value,
                    changeMatching -> price only-element -> value,
                    direction
                )

    alias updatedDatedValues: <"If there is already a datedValue for the effective date then update that, otherwise insert a new datedValue for the effective date with the new price. The list of datedValues should only be updated if an effective date has been passed in. ">
        if changeEffectiveDate exists
        then if containsEffectiveDate
            then UpdateDatedValue(
                        price -> datedValue,
                        changeMatching -> price only-element -> value,
                        direction,
                        changeEffectiveDate
                    )
            else InsertDatedValue(
                    price -> datedValue,
                    changeMatching -> price only-element -> value,
                    direction,
                    changeEffectiveDate
                )

    set updatedPrice: price
    set updatedPrice -> value: changedAmount default price -> value
    set updatedPrice -> datedValue: updatedDatedValues default price -> datedValue

func UpdateQuantityAmountForEachMatchingQuantity: <"Updates any quantity from the NonNegativeQuantitySchedule list if the unit of amount matches.">
    inputs:
        quantity NonNegativeQuantitySchedule (0..1) <"List of NonNegativeQuantitySchedule to update.">
            [metadata location]
        change PriceQuantity (0..*) <"List of new PriceQuantity elements to be applied where units match. PriceQuantity is defined as input to ensure the quantity change remains associated with its corresponding effectiveDate.">
        direction QuantityChangeDirectionEnum (1..1) <"Enum specifying how the updated amounts should be applied, e.g., add, subtract or replace.">
    output:
        updatedQuantity NonNegativeQuantitySchedule (0..1)
            [metadata location]

    alias changeMatching:
        SplitQuantityChange(change)
            filter UnitEquals(item -> quantity only-element -> unit, quantity -> unit)
            then first

    alias changedAmount:
        UpdateAmount(
                quantity -> value,
                changeMatching -> quantity only-element -> value,
                direction
            )

    alias changeEffectiveDate:
        AdjustableDateResolution(changeMatching -> effectiveDate -> adjustableDate)
    // ResolveAdjustableDate(changeMatching -> effectiveDate)
    // TODO uncomment usage once function is available
    alias changedDatedValue:
        UpdateNonNegativeDatedValues(
                quantity -> datedValue,
                changeMatching -> quantity only-element -> value,
                direction,
                changeEffectiveDate
            )

    set updatedQuantity: quantity
    set updatedQuantity -> value: changedAmount default quantity -> value
    set updatedQuantity -> datedValue: changedDatedValue default quantity -> datedValue

func PriceUnitEquals: <"Compares two PriceSchedule to check if all attributes match, except for the amount.">
    inputs:
        p1 PriceSchedule (0..1)
        p2 PriceSchedule (0..1)
    output:
        result boolean (1..1)

    alias unitMatches: UnitEquals(p1 -> unit, p2 -> unit)
    alias perUnitOfMatches: UnitEquals(p1 -> perUnitOf, p2 -> perUnitOf)
    alias priceTypeMatches:
        (p1 -> priceType is absent and p2 -> priceType is absent)
            or p1 -> priceType = p2 -> priceType
    alias priceSubTypeMatches:
        (p1 -> priceSubType is absent and p2 -> priceSubType is absent)
            or p1 -> priceSubType = p2 -> priceSubType
    alias priceExpressionMatches:
        (p1 -> priceExpression is absent and p2 -> priceExpression is absent)
            or p1 -> priceExpression = p2 -> priceExpression
    alias arithmeticOperatorMatches:
        (p1 -> arithmeticOperator is absent and p2 -> arithmeticOperator is absent)
            or p1 -> arithmeticOperator = p2 -> arithmeticOperator

    set result:
        unitMatches and perUnitOfMatches and priceTypeMatches and priceSubTypeMatches and priceExpressionMatches and arithmeticOperatorMatches

func SplitQuantityChange: <"Splits a PriceQuantity list into separate elements, each containing a single quantity and its corresponding effective date, if multiple quantities exist.">
    inputs:
        changeList PriceQuantity (1..*) <"Original PriceQuantity list where each of them may contain multiple quantities.">
    output:
        splitChange PriceQuantity (1..*) <"New list of PriceQuantity where each of them contain a single quantity.">

    set splitChange: <"Iterates through the original PriceQuantity list and the quantity list.">
        changeList
            extract change [
                change -> quantity
                    extract quantity [
                        PriceQuantity {
                            quantity: quantity,
                            effectiveDate: change -> effectiveDate,
                            ...
                        }
                    ]
            ]
