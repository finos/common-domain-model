namespace cdm.mapping
version "${project.version}"

type SecuritiesLoan: <"Simplified representation of a securities-lending transaction.">
    [rootType]
    loanIdentifier string (0..1) <"Client order ID of the originating FIX order.">
    loanedSecurity LoanedSecurity (0..1) <"The security being lent.">
    quantity number (0..1) <"Number of shares lent.">
    currency string (0..1) <"Loan and collateral currency.">
    settlementDate date (0..1) <"Date on which the loan settles.">
    executionTimestamp zonedDateTime (0..1) <"Time at which the order was placed.">
    lender string (0..1) <"Party lending the security (FIX role 1, executing firm).">
    borrower string (0..1) <"Party borrowing the security (FIX role 17, contra firm).">
    clearingOrganisation string (0..1) <"Clearing organisation (FIX role 21).">

type LoanedSecurity: <"Identification of the security being lent.">
    ticker string (0..1) <"Exchange ticker symbol.">
    identifier string (0..1) <"Security identifier, e.g. an ISIN.">
    exchange string (0..1) <"Market identifier code of the listing exchange.">