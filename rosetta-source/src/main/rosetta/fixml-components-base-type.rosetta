namespace cdm.fixml.components.base : < "test" >
version "${project.version}"

import cdm.fixml.fields.base.*
import cdm.fixml.fields.impl.*

typeAlias Version_t:
    string(pattern: "(FIX.2.7)|(FIX.3.0)|(FIX\\.4\\.[0-4])|(FIX\\.5\\.0(SP[1-3]))|(FIXT.1.[1-2])")

type BaseHeader_t:

    msgTyp MsgType_t (0..1)
    applVerID ApplVerID_t (0..1)
    sid SenderCompID_t (0..1)
    tid TargetCompID_t (0..1)
    obid OnBehalfOfCompID_t (0..1)
    d2ID DeliverToCompID_t (0..1)
    seqNum MsgSeqNum_t (0..1)
    sSub SenderSubID_t (0..1)
    sLoc SenderLocationID_t (0..1)
    tSub TargetSubID_t (0..1)
    tLoc TargetLocationID_t (0..1)
    obSub OnBehalfOfSubID_t (0..1)
    obLoc OnBehalfOfLocationID_t (0..1)
    d2Sub DeliverToSubID_t (0..1)
    d2Loc DeliverToLocationID_t (0..1)
    posDup PossDupFlag_t (0..1)
    posRsnd PossResend_t (0..1)
    snt SendingTime_t (0..1)
    origSnt OrigSendingTime_t (0..1)
    msgEncd MessageEncoding_t (0..1)
    hop HopGrp_Block_t (0..*)

type HopGrp_Block_t:

    id HopCompID_t (0..1)
    snt HopSendingTime_t (0..1)
    ref HopRefID_t (0..1)

type MessageHeader_t extends BaseHeader_t:

type BatchHeader_t extends BaseHeader_t:

type Abstract_message_t:

    hdr MessageHeader_t (0..1)

type Batch_t:

    id string (0..1)
    totMsg int (0..1)
    hdr BatchHeader_t (0..1)
    message Abstract_message_t (0..*)

type FIXML:

    v Version_t (0..1)
    r string (0..1)
    xv int (0..1)
    cv string (0..1)
    xr string (0..1)
    s date (0..1)
    message Abstract_message_t (0..1)
    batch Batch_t (0..*)

    condition Choice:
        required choice message, batch

