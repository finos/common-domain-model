namespace cdm.fixml.indications.base : < "test" >
version "${project.version}"

import cdm.fixml.components.base.*
import cdm.fixml.fields.base.*
import cdm.fixml.fields.impl.*

type IOI extends IOI_message_t:

type Adv extends Advertisement_message_t:

type IOI_message_t extends Abstract_message_t: <"IOI can be found in Volume 3 of the \t\t\t\t\t\tspecification">

    id IOIID_t (1..1)
    transTyp IOITransType_t (1..1)
    refID IOIRefID_t (0..1)
    side Side_t (1..1)
    qtyTyp QtyType_t (0..1)
    qty IOIQty_t (1..1)
    ccy Currency_t (0..1)
    pxTyp PriceType_t (0..1)
    px Price_t (0..1)
    validUntilTm ValidUntilTime_t (0..1)
    qltyInd IOIQltyInd_t (0..1)
    natFlag IOINaturalFlag_t (0..1)
    txt Text_t (0..1)
    encTxtLen EncodedTextLen_t (0..1)
    encTxt EncodedText_t (0..1)
    txnTm TransactTime_t (0..1)
    url URLLink_t (0..1)
    applSeqCtrl ApplicationSequenceControl_Block_t (0..1)
    instrmt Instrument_Block_t (1..1)
    pty Parties_Block_t (0..*)
    finDetls FinancingDetails_Block_t (0..1)
    undly UndInstrmtGrp_Block_t (0..*)
    ordQty OrderQtyData_Block_t (0..1)
    stip Stipulations_Block_t (0..*)
    ioi InstrmtLegIOIGrp_Block_t (0..*)
    qual IOIQualGrp_Block_t (0..*)
    rtg RoutingGrp_Block_t (0..*)
    sprdBnchmkCurve SpreadOrBenchmarkCurveData_Block_t (0..1)
    yield YieldData_Block_t (0..1)

type Advertisement_message_t extends Abstract_message_t: <"Advertisement can be found in Volume 3 of the \t\t\t\t\t\tspecification">

    advId AdvId_t (1..1)
    advTransTyp AdvTransType_t (1..1)
    advRefID AdvRefID_t (0..1)
    advSide AdvSide_t (1..1)
    qty Quantity_t (1..1)
    qtyTyp QtyType_t (0..1)
    px Price_t (0..1)
    ccy Currency_t (0..1)
    trdDt TradeDate_t (0..1)
    txnTm TransactTime_t (0..1)
    txt Text_t (0..1)
    encTxtLen EncodedTextLen_t (0..1)
    encTxt EncodedText_t (0..1)
    url URLLink_t (0..1)
    lastMkt LastMkt_t (0..1)
    sesID TradingSessionID_t (0..1)
    sesSub TradingSessionSubID_t (0..1)
    instrmt Instrument_Block_t (1..1)
    leg InstrmtLegGrp_Block_t (0..*)
    undly UndInstrmtGrp_Block_t (0..*)

type IOIQualGrp_Block_t:

    qual IOIQualifier_t (0..1)
