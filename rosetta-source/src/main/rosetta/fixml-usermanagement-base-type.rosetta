namespace cdm.fixml.usermanagement.base : < "test" >
version "${project.version}"

import cdm.fixml.components.base.*
import cdm.fixml.fields.base.*
import cdm.fixml.fields.impl.*

type UserReq extends UserRequest_message_t:

type UserRsp extends UserResponse_message_t:

type UserNotifctn extends UserNotification_message_t:

type UserRequest_message_t extends Abstract_message_t: <"UserRequest can be found in Volume 1 of the \t\t\t\t\t\tspecification">

    userReqID UserRequestID_t (1..1)
    userReqTyp UserRequestType_t (1..1)
    username Username_t (1..1)
    password Password_t (0..1)
    newPassword NewPassword_t (0..1)
    encPwdMethod EncryptedPasswordMethod_t (0..1)
    encPwd EncryptedPassword_t (0..1)
    encNewPwd EncryptedNewPassword_t (0..1)
    rawDataLength RawDataLength_t (0..1)
    rawData RawData_t (0..1)

type UserResponse_message_t extends Abstract_message_t: <"UserResponse can be found in Volume 1 of the \t\t\t\t\t\tspecification">

    userReqID UserRequestID_t (1..1)
    username Username_t (1..1)
    userStat UserStatus_t (0..1)
    userStatText UserStatusText_t (0..1)

type UserNotification_message_t extends Abstract_message_t: <"UserNotification can be found in Volume 1 of the \t\t\t\t\t\tspecification">

    userStat UserStatus_t (1..1)
    txt Text_t (0..1)
    encTxtLen EncodedTextLen_t (0..1)
    encTxt EncodedText_t (0..1)
    userGrp UsernameGrp_Block_t (0..*)

type UsernameGrp_Block_t:

    username Username_t (0..1)
