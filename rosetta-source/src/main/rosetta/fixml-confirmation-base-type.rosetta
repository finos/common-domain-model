namespace cdm.fixml.confirmation.base : < "test" >
version "${project.version}"

import cdm.fixml.components.base.*
import cdm.fixml.fields.base.*
import cdm.fixml.fields.impl.*

type Cnfm extends Confirmation_message_t:

type CnfmAck extends ConfirmationAck_message_t:

type CnfmReq extends ConfirmationRequest_message_t:

type Confirmation_message_t extends Abstract_message_t: <"Confirmation can be found in Volume 5 of the \t\t\t\t\t\tspecification">

    cnfmID ConfirmID_t (1..1)
    cnfmRefID ConfirmRefID_t (0..1)
    cnfmReqID ConfirmReqID_t (0..1)
    cnfmTransTyp ConfirmTransType_t (1..1)
    cnfmTyp ConfirmType_t (1..1)
    copyMsgInd CopyMsgIndicator_t (0..1)
    legalCnfm LegalConfirm_t (0..1)
    cnfmStat ConfirmStatus_t (1..1)
    allocID AllocID_t (0..1)
    allocID2 SecondaryAllocID_t (0..1)
    indAllocID IndividualAllocID_t (0..1)
    txnTm TransactTime_t (1..1)
    trdDt TradeDate_t (1..1)
    qty AllocQty_t (1..1)
    qtyTyp QtyType_t (0..1)
    side Side_t (1..1)
    ccy Currency_t (0..1)
    lastMkt LastMkt_t (0..1)
    acct AllocAccount_t (1..1)
    actIDSrc AllocAcctIDSource_t (0..1)
    acctTyp AllocAccountType_t (0..1)
    avgPx AvgPx_t (1..1)
    avgPxPrcsn AvgPxPrecision_t (0..1)
    pxTyp PriceType_t (0..1)
    avgParPx AvgParPx_t (0..1)
    rptedPx ReportedPx_t (0..1)
    txt Text_t (0..1)
    encTxtLen EncodedTextLen_t (0..1)
    encTxt EncodedText_t (0..1)
    procCode ProcessCode_t (0..1)
    grossTrdAmt GrossTradeAmt_t (1..1)
    numDaysInt NumDaysInterest_t (0..1)
    exDt ExDate_t (0..1)
    acrdIntRt AccruedInterestRate_t (0..1)
    acrdIntAmt AccruedInterestAmt_t (0..1)
    intAtMat InterestAtMaturity_t (0..1)
    endAcrdIntAmt EndAccruedInterestAmt_t (0..1)
    startCsh StartCash_t (0..1)
    endCsh EndCash_t (0..1)
    concession Concession_t (0..1)
    totTakedown TotalTakedown_t (0..1)
    netMny NetMoney_t (1..1)
    matNetMny MaturityNetMoney_t (0..1)
    settlCurrAmt SettlCurrAmt_t (0..1)
    settlCcy SettlCurrency_t (0..1)
    settlCurrFxRt SettlCurrFxRate_t (0..1)
    settlCurrFxRtCalc SettlCurrFxRateCalc_t (0..1)
    settlTyp SettlType_t (0..1)
    settlDt SettlDate_t (0..1)
    sharedComm SharedCommission_t (0..1)
    pty Parties_Block_t (0..*)
    ordAlloc OrdAllocGrp_Block_t (0..*)
    trdRegTS TrdRegTimestamps_Block_t (0..*)
    instrmt Instrument_Block_t (1..1)
    instrmtExt InstrumentExtension_Block_t (0..1)
    finDetls FinancingDetails_Block_t (0..1)
    undly UndInstrmtGrp_Block_t (0..*)
    leg InstrmtLegGrp_Block_t (0..*)
    yield YieldData_Block_t (0..1)
    cpcty CpctyConfGrp_Block_t (1..*)
    sprdBnchmkCurve SpreadOrBenchmarkCurveData_Block_t (0..1)
    setInstr SettlInstructionsData_Block_t (0..1)
    comm CommissionData_Block_t (0..1)
    stip Stipulations_Block_t (0..*)
    miscFees MiscFeesGrp_Block_t (0..*)

type ConfirmationAck_message_t extends Abstract_message_t: <"ConfirmationAck can be found in Volume 5 of the \t\t\t\t\t\tspecification">

    cnfmID ConfirmID_t (1..1)
    trdDt TradeDate_t (1..1)
    txnTm TransactTime_t (1..1)
    affirmStat AffirmStatus_t (1..1)
    cnfmRejRsn ConfirmRejReason_t (0..1)
    mtchStat MatchStatus_t (0..1)
    txt Text_t (0..1)
    encTxtLen EncodedTextLen_t (0..1)
    encTxt EncodedText_t (0..1)

type ConfirmationRequest_message_t extends Abstract_message_t: <"ConfirmationRequest can be found in Volume 5 of the \t\t\t\t\t\tspecification">

    cnfmReqID ConfirmReqID_t (1..1)
    cnfmTyp ConfirmType_t (1..1)
    allocID AllocID_t (0..1)
    allocID2 SecondaryAllocID_t (0..1)
    indAllocID IndividualAllocID_t (0..1)
    txnTm TransactTime_t (1..1)
    acct AllocAccount_t (0..1)
    actIDSrc AllocAcctIDSource_t (0..1)
    acctTyp AllocAccountType_t (0..1)
    txt Text_t (0..1)
    encTxtLen EncodedTextLen_t (0..1)
    encTxt EncodedText_t (0..1)
    ordAlloc OrdAllocGrp_Block_t (0..*)

type CpctyConfGrp_Block_t:

    cpcty OrderCapacity_t (1..1)
    rstctions OrderRestrictions_t (0..1)
    cpctyQty OrderCapacityQty_t (1..1)
