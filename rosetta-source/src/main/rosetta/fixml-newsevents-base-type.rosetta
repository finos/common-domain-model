namespace cdm.fixml.newsevents.base : < "test" >
version "${project.version}"

import cdm.fixml.components.base.*
import cdm.fixml.fields.base.*
import cdm.fixml.fields.impl.*

type News extends News_message_t:

type Email extends Email_message_t:

type News_message_t extends Abstract_message_t: <"News can be found in Volume 3 of the \t\t\t\t\t\tspecification">

    id NewsID_t (0..1)
    newsCatgy NewsCategory_t (0..1)
    langCd LanguageCode_t (0..1)
    origTm OrigTime_t (0..1)
    urgency Urgency_t (0..1)
    headline Headline_t (1..1)
    encHeadlineLen EncodedHeadlineLen_t (0..1)
    encHeadline EncodedHeadline_t (0..1)
    mktID MarketID_t (0..1)
    mktSegID MarketSegmentID_t (0..1)
    url URLLink_t (0..1)
    rawDataLength RawDataLength_t (0..1)
    rawData RawData_t (0..1)
    applSeqCtrl ApplicationSequenceControl_Block_t (0..1)
    refs NewsRefGrp_Block_t (0..*)
    rtg RoutingGrp_Block_t (0..*)
    inst InstrmtGrp_Block_t (0..*)
    leg InstrmtLegGrp_Block_t (0..*)
    undly UndInstrmtGrp_Block_t (0..*)
    txtLn LinesOfTextGrp_Block_t (1..*)

type Email_message_t extends Abstract_message_t: <"Email can be found in Volume 3 of the \t\t\t\t\t\tspecification">

    emailThreadID EmailThreadID_t (1..1)
    emailTyp EmailType_t (1..1)
    origTm OrigTime_t (0..1)
    subject Subject_t (1..1)
    encSubjectLen EncodedSubjectLen_t (0..1)
    encSubject EncodedSubject_t (0..1)
    ordID OrderID_t (0..1)
    clOrdID ClOrdID_t (0..1)
    rawDataLength RawDataLength_t (0..1)
    rawData RawData_t (0..1)
    rtg RoutingGrp_Block_t (0..*)
    inst InstrmtGrp_Block_t (0..*)
    undly UndInstrmtGrp_Block_t (0..*)
    leg InstrmtLegGrp_Block_t (0..*)
    txtLn LinesOfTextGrp_Block_t (1..*)

type NewsRefGrp_Block_t:

    refID NewsRefID_t (0..1)
    refTyp NewsRefType_t (0..1)
