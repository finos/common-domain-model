    UTCTimestamp

typeAlias ListStatusText_t: <"Free format text string related to List Status.">
    string

typeAlias EncodedListStatusTextLen_t: <"Byte length of encoded (non-ASCII characters) EncodedListStatusText (446) field.">
    Length

