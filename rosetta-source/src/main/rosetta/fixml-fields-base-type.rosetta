    string

typeAlias MailingDtls_t: <"Set of Correspondence address details, possibly including phone, fax, etc.">
    string

typeAlias InvestorCountryOfResidence_t: <"The ISO 366 Country code (2 character) identifying which country the beneficial investor is resident for tax purposes.">
    Country

typeAlias PaymentRef_t: <"\"Settlement Payment Reference\" - A free format Payment reference to assist with reconciliation, e.g. a Client and/or Order ID number.">
    string

