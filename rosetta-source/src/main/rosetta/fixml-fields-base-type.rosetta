    string

typeAlias CashDistribPayRef_t: <"Free format Payment reference to assist with reconciliation of distributions.">
    string

typeAlias CashDistribAgentAcctName_t: <"Name of account at agent bank for distributions.">
    string

typeAlias CardStartDate_t: <"The start date of the card as specified on the card being used for payment.">
