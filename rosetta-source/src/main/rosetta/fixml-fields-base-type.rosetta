typeAlias MarginExcess_t: <"Excess margin amount (deficit if value is negative)">
    Amt

typeAlias TotalNetValue_t: <"TotalNetValue is determined as follows: At the initial collateral assignment TotalNetValue is the sum of (UnderlyingStartValue * (1-haircut)). In a collateral substitution TotalNetValue is the sum of (UnderlyingCurrentValue * (1-haircut)). For listed derivatives clearing margin management, this is the collateral value which equals (Market value * haircut)">
    Amt

typeAlias CashOutstanding_t: <"Starting consideration less repayments">
    Amt

typeAlias CollAsgnID_t: <"Collateral Assignment Identifier">
    string

typeAlias CollRespID_t: <"Collateral Response Identifier">
    string

typeAlias CollAsgnRefID_t: <"Collateral Assignment Identifier to which a transaction refers">
    string

typeAlias CollRptID_t: <"Collateral Report Identifier">
    string

typeAlias CollInquiryID_t: <"Collateral Inquiry Identifier">
    string

typeAlias TotNumReports_t: <"Total number of reports returned in response to a request.">
    int

typeAlias AgreementDesc_t: <"The full name of the base standard agreement, annexes and amendments in place between the principals applicable to a financing transaction.">
    string

typeAlias AgreementID_t: <"A common reference to the applicable standing agreement between the counterparties to a financing transaction.">
    string

typeAlias AgreementDate_t: <"A reference to the date the underlying agreement specified by AgreementID and AgreementDesc was executed.">
    LocalMktDate

typeAlias StartDate_t: <"Start date of a financing deal, i.e. the date the buyer pays the seller cash and takes control of the collateral">
    LocalMktDate

typeAlias EndDate_t: <"End date of a financing deal, i.e. the date the seller reimburses the buyer and takes back control of the collateral">
    LocalMktDate

typeAlias AgreementCurrency_t: <"Contractual currency forming the basis of a financing agreement and associated transactions. Usually, but not always, the same as the trade currency.">
    Currency

typeAlias EndAccruedInterestAmt_t: <"Accrued Interest Amount applicable to a financing transaction on the End Date.">
    Amt

typeAlias StartCash_t: <"Starting dirty cash consideration of a financing deal, i.e. paid to the seller on the Start Date.">
    Amt

typeAlias EndCash_t: <"Ending dirty cash consideration of a financing deal. i.e. reimbursed to the buyer on the End Date.">
    Amt

typeAlias UserRequestID_t: <"Unique identifier for a User Request.">
    string

typeAlias NewPassword_t: <"New Password or passphrase">
    string

typeAlias UserStatusText_t: <"A text description associated with a user status.">
    string

typeAlias StatusText_t: <"A text description associated with a network status.">
    string

typeAlias RefCompID_t: <"Assigned value used to identify a firm.">
    string

typeAlias RefSubID_t: <"Assigned value used to identify specific elements within a firm.">
    string

typeAlias NetworkResponseID_t: <"Unique identifier for a network response.">
    string

typeAlias NetworkRequestID_t: <"Unique identifier for a network resquest.">
    string

typeAlias LastNetworkResponseID_t: <"Identifier of the previous Network Response message sent to a counterparty, used to allow incremental updates.">
    string

typeAlias UnderlyingStrikeCurrency_t: <"Currency in which the strike price of an underlying instrument is denominated">
    Currency

typeAlias LegStrikeCurrency_t: <"Currency in which the strike price of a instrument leg of a multileg instrument is denominated">
    Currency

typeAlias TimeBracket_t: <"A code that represents a time interval in which a fill or trade occurred. Required for US futures markets.">
    string

typeAlias StrikeCurrency_t: <"Currency in which the StrikePrice is denominated.">
    Currency

typeAlias Nested3PartyID_t: <"PartyID value within a \"third instance\" Nested repeating group. Same values as PartyID (448)">
    string

typeAlias Nested3PartySubID_t: <"PartySubID value within a \"third instance\" Nested repeating group. Same values as PartySubID (523)">
    string

typeAlias LegContractSettlMonth_t: <"Specifies when the contract (i.e. MBS/TBA) will settle.">
    MonthYear

typeAlias LegInterestAccrualDate_t: <"The start date used for calculating accrued interest on debt instruments which are being sold between interest payment dates. Often but not always the same as the Issue Date and the Dated Date">
    LocalMktDate

typeAlias StrategyParameterName_t: <"Name of parameter">
    string

typeAlias StrategyParameterValue_t: <"Value of the parameter">
    string

typeAlias HostCrossID_t: <"Host assigned entity ID that can be used to reference all components of a cross; sides + strategy + legs. Used as the primary key with which to refer to the Cross Order for cancellation and replace. The HostCrossID will also be used to link together components of the Cross Order. For example, each individual Execution Report associated with the order will carry HostCrossID in order to tie back to the original cross order.">
    string

typeAlias SideTimeInForce_t: <"Indicates how long the order as specified in the side stays in effect. SideTimeInForce allows a two-sided cross order to specify order behavior separately for each side. Absence of this field indicates that TimeInForce should be referenced. SideTimeInForce will override TimeInForce if both are provided.">
    UTCTimestamp

typeAlias MDReportID_t: <"Unique identifier for the Market Data Report.">
    int

typeAlias SecurityReportID_t: <"Identifies a Security List message.">
    int

typeAlias SettleOnOpenFlag_t: <"Indicator to determine if instrument is settle on open">
    string

typeAlias StrikeMultiplier_t: <"Used for derivatives. Multiplier applied to the strike price for the purpose of calculating the settlement value.">
    number

typeAlias StrikeValue_t: <"Used for derivatives. The number of shares/units for the financial instrument involved in the option trade.">
    number

typeAlias MinPriceIncrement_t: <"Minimum price increase for a given exchange-traded Instrument">
    number

typeAlias PositionLimit_t: <"Position Limit for a given exchange-traded product.">
    int

typeAlias NTPositionLimit_t: <"Position Limit in the near-term contract for a given exchange-traded product.">
    int

typeAlias UnderlyingAllocationPercent_t: <"Percent of the Strike Price that this underlying represents.">
    Percentage

typeAlias UnderlyingCashAmount_t: <"Cash amount associated with the underlying component.">
    Amt

typeAlias QuantityDate_t: <"Date associated to the quantity that is being reported for the position.">
    LocalMktDate

typeAlias ContIntRptID_t: <"Unique identifier for the Contrary Intention report">
    string

typeAlias LateIndicator_t: <"Indicates if the contrary intention was received after the exchange imposed cutoff time">
    Boolean

typeAlias InputSource_t: <"Source of the contrary intention">
    string

typeAlias ExpQty_t: <"Expiration Quantity associated with the Expiration Type">
    Qty

typeAlias UnderlyingPayAmount_t: <"Amount to pay in order to receive the underlying instrument">
    Amt

typeAlias UnderlyingCollectAmount_t: <"Amount to collect in order to deliver the underlying instrument">
    Amt

typeAlias UnderlyingSettlementDate_t: <"Date the underlying instrument will settle. Used for derivatives that deliver into more than one underlying instrument. Settlement dates can vary across underlying instruments.">
    LocalMktDate

typeAlias UnderlyingSettlementStatus_t: <"Settlement status of the underlying instrument. Used for derivatives that deliver into more than one underlying instrument. Settlement can be delayed for an underlying instrument.">
    string

typeAlias SecondaryIndividualAllocID_t: <"Will allow the intermediary to specify an allocation ID generated by their system.">
    string

typeAlias LegReportID_t: <"Additional attribute to store the Trade ID of the Leg.">
    string

typeAlias RndPx_t: <"Specifies average price rounded to quoted precision.">
    Price

typeAlias AllocCustomerCapacity_t: <"Capacity of customer in the allocation block.">
    string

typeAlias TierCode_t: <"The Tier the trade was matched by the clearing system.">
    string

typeAlias TradeID_t: <"The unique ID assigned to the trade entity once it is received or matched by the exchange or central counterparty.">
    string

typeAlias SideTradeReportID_t: <"Used on a multi-sided trade to designate the ReportID">
    string

typeAlias SideFillStationCd_t: <"Used on a multi-sided trade to convey order routing information">
    string

typeAlias SideReasonCd_t: <"Used on a multi-sided trade to convey reason for execution">
    string

typeAlias SideLastQty_t: <"Used to indicate the quantity on one of a multi-sided Trade Capture Report">
    int

typeAlias MessageEventSource_t: <"Used to identify the event or source which gave rise to a message. Valid values will be based on an exchange\'s implementation. Example values are: \"MQM\" (originated at Firm Back Office) \"Clear\" (originated in Clearing System) \"Reg\" (static data generated via Register request)">
    string

typeAlias SideTrdRegTimestamp_t: <"Will be used in a multi-sided message. Traded Regulatory timestamp value Use to store time information required by government regulators or self regulatory organizations such as an exchange or clearing house">
    UTCTimestamp

typeAlias SideTrdRegTimestampSrc_t: <"Same as TrdRegTimestampOrigin Text which identifies the origin i.e. system which was used to generate the time stamp for the Traded Regulatory timestamp value">
    string

typeAlias LegOptionRatio_t: <"Expresses the risk of an option leg Value must be between -1 and 1. A Call Option will require a ratio value between 0 and 1 A Put Option will require a ratio value between -1 and 0">
    number

typeAlias InstrumentPartyID_t: <"PartyID value within an instrument party repeating group. Same values as PartyID (448)">
    string

typeAlias TradeVolume_t: <"Used to report volume with a trade">
    Qty

typeAlias MDFeedType_t: <"Describes a class of service for a given data feed, ie Regular and Market Maker, Bandwidth Intensive or Bandwidth Conservative">
    string

typeAlias MDPriceLevel_t: <"Integer to convey the level of a bid or offer at a given price level. This is in contrast to MDEntryPositionNo which is used to convey the position of an order within a Price level">
    int

typeAlias FirstPx_t: <"Indicates the first trade price of the day/session">
    Price

typeAlias MDEntrySpotRate_t: <"The spot rate for an FX entry">
    number

typeAlias MDEntryForwardPoints_t: <"Used for an F/X entry. The forward points to be added to or subtracted from the spot rate to get the \"all-in\" rate in MDEntryPx. Expressed in decimal form. For example, 61.99 points is expressed and sent as 0.006199">
    PriceOffset

typeAlias ManualOrderIndicator_t: <"Indicates if the order was initially received manually (as opposed to electronically)">
    Boolean

typeAlias CustDirectedOrder_t: <"Indicates if the customer directed this order to a specific execution venue \"Y\" or not \"N\". A default of \"N\" customer did not direct this order should be used in the case where the information is both missing and essential.">
    Boolean

typeAlias ReceivedDeptID_t: <"Identifies the Broker / Dealer Department that first took the order.">
    string

typeAlias CustOrderHandlingInst_enum_t: <"Codes that apply special information that the Broker / Dealer needs to report, as specified by the customer. NOTE: This field and its values have no bearing on the ExecInst and TimeInForce fields. These values should not be used instead of ExecInst or TimeInForce. This field and its values are intended for compliance reporting only. Valid values are grouped by OrderHandlingInstSource(1032).">
    string(pattern: "((ADD)|(AON)|(CNH)|(DIR)|(E.W)|(FOK)|(IO)|(IOC)|(LOO)|(LOC)|(MAO)|(MAC)|(MOO)|(MOC)|(MQT)|(NH)|(OVD)|(PEG)|(RSV)|(S.W)|(SCL)|(TMO)|(TS)|(WRK))(\\s((ADD)|(AON)|(CNH)|(DIR)|(E.W)|(FOK)|(IO)|(IOC)|(LOO)|(LOC)|(MAO)|(MAC)|(MOO)|(MOC)|(MQT)|(NH)|(OVD)|(PEG)|(RSV)|(S.W)|(SCL)|(TMO)|(TS)|(WRK)))*")

typeAlias DeskOrderHandlingInst_enum_t: <"Codes that apply special information that the Broker / Dealer needs to report. NOTE: This field and its values have no bearing on the ExecInst and TimeInForce fields. These values should not be used instead of ExecInst or TimeInForce. This field and its values are intended for compliance reporting only. Valid values are grouped by OrderHandlingInstSource(1032).">
    string(pattern: "((ADD)|(AON)|(CNH)|(DIR)|(E.W)|(FOK)|(IO)|(IOC)|(LOO)|(LOC)|(MAO)|(MAC)|(MOO)|(MOC)|(MQT)|(NH)|(OVD)|(PEG)|(RSV)|(S.W)|(SCL)|(TMO)|(TS)|(WRK))(\\s((ADD)|(AON)|(CNH)|(DIR)|(E.W)|(FOK)|(IO)|(IOC)|(LOO)|(LOC)|(MAO)|(MAC)|(MOO)|(MOC)|(MQT)|(NH)|(OVD)|(PEG)|(RSV)|(S.W)|(SCL)|(TMO)|(TS)|(WRK)))*")

typeAlias UnderlyingDeliveryAmount_t: <"Indicates the underlying position amount to be delivered">
    Amt

typeAlias UnderlyingCapValue_t: <"Maximum notional value for a capped financial instrument">
    Amt

typeAlias UnderlyingSettlMethod_t: string

typeAlias SecondaryTradeID_t: <"Used to carry an internal trade entity ID which may or may not be reported to the firm">
    string

typeAlias FirmTradeID_t: <"The ID assigned to a trade by the Firm to track a trade within the Firm system. This ID can be assigned either before or after submission to the exchange or central counterpary">
    string

typeAlias SecondaryFirmTradeID_t: <"Used to carry an internal firm assigned ID which may or may not be reported to the exchange or central counterpary">
    string

typeAlias UnderlyingAdjustedQuantity_t: <"Unit amount of the underlying security (shares) adjusted for pending corporate action not yet allocated.">
    Qty

typeAlias UnderlyingFXRate_t: <"Foreign exchange rate used to compute UnderlyingCurrentValue(885) (or market value) from UnderlyingCurrency(318) to Currency(15).">
    number

typeAlias InstrumentPartySubID_t: <"PartySubID value within an instrument party repeating group. Same values as PartySubID (523)">
    string

typeAlias PositionCurrency_t: <"The Currency in which the position Amount is denominated">
    string

typeAlias CalculatedCcyLastQty_t: <"Used for the calculated quantity of the other side of the currency trade. Can be derived from LastQty and LastPx.">
    Qty

typeAlias UnderlyingInstrumentPartyID_t: <"PartyID value within an underlying instrument party repeating group. Same values as PartyID (448)">
    string

typeAlias UnderlyingInstrumentPartySubID_t: <"PartySubID value within an underlying instrument party repeating group. Same values as PartySubID (523)">
    string

typeAlias BidSwapPoints_t: <"The bid FX Swap points for an FX Swap. It is the \"far bid forward points - near offer forward point\". Value can be negative. Expressed in decimal form. For example, 61.99 points is expressed and sent as 0.006199">
    PriceOffset

typeAlias OfferSwapPoints_t: <"The offer FX Swap points for an FX Swap. It is the \"far offer forward points - near bid forward points\". Value can be negative. Expressed in decimal form. For example, 61.99 points is expressed and sent as 0.006199">
    PriceOffset

typeAlias LegBidForwardPoints_t: <"The bid FX forward points for the leg of an FX Swap. Value can be negative. Expressed in decimal form. For example, 61.99 points is expressed and sent as 0.006199">
    PriceOffset

typeAlias LegOfferForwardPoints_t: <"The offer FX forward points for the leg of an FX Swap. Value can be negative. Expressed in decimal form. For example, 61.99 points is expressed and sent as 0.006199">
    PriceOffset

typeAlias SwapPoints_t: <"For FX Swap, this is used to express the differential between the far leg\'s bid/offer and the near leg\'s bid/offer. Value can be negative. Expressed in decimal form. For example, 61.99 points is expressed and sent as 0.006199">
    PriceOffset

typeAlias LastSwapPoints_t: <"For FX Swap, this is used to express the last market event for the differential between the far leg\'s bid/offer and the near leg\'s bid/offer in a fill or partial fill. Value can be negative. Expressed in decimal form. For example, 61.99 points is expressed and sent as 0.006199">
    PriceOffset

typeAlias SideGrossTradeAmt_t: <"The gross trade amount for this side of the trade. See also GrossTradeAmt (381) for additional definition.">
    Amt

typeAlias LegLastForwardPoints_t: <"The forward points for this leg\'s fill event. Value can be negative. Expressed in decimal form. For example, 61.99 points is expressed and sent as 0.006199">
    PriceOffset

typeAlias LegCalculatedCcyLastQty_t: <"Used for the calculated quantity of the other side of the currency for this leg. Can be derived from LegQty and LegLastPx.">
    Qty

typeAlias LegGrossTradeAmt_t: <"The gross trade amount of the leg. For FX Futures this is used to express the notional value of a fill when LegLastQty and other quantity fields are express in terms of contract size.">
    Amt

typeAlias MaturityTime_t: <"Time of security\'s maturity expressed in local time with offset to UTC specified">
    TZTimeOnly

typeAlias RefOrderID_t: <"The ID reference to the order being hit or taken">
    string

typeAlias SecondaryDisplayQty_t: <"Used for reserve orders when DisplayQty applies to the primary execution market (e.g.an ECN) and another quantity is to be shown at other markets (e.g. the exchange). On orders specifies the qty to be displayed, on execution reports the currently displayed quantity.">
    Qty

typeAlias DisplayLowQty_t: <"Defines the lower quantity limit to a randomized refresh of DisplayQty.">
    Qty

typeAlias DisplayHighQty_t: <"Defines the upper quantity limit to a randomized refresh of DisplayQty.">
    Qty

typeAlias DisplayMinIncr_t: <"Defines the minimum increment to be used when calculating a random refresh of DisplayQty. A user specifies this when he wants a larger increment than the standard provided by the market (e.g. the round lot size).">
    Qty

typeAlias RefreshQty_t: <"Defines the quantity used to refresh DisplayQty.">
    Qty

typeAlias MatchIncrement_t: <"Allows orders to specify a minimum quantity that applies to every execution (one execution could be for multiple counter-orders). The order may still fill against smaller orders, but the cumulative quantity of the execution must be in multiples of the MatchIncrement.">
    Qty

typeAlias MaxPriceLevels_t: <"Allows an order to specify a maximum number of price levels to trade through. Only valid for aggressive orders and during continuous (autoexecution) trading sessions. Property lost when order is put on book. A partially filled order is assigned last trade price as limit price. Non-filled order behaves as ordinary Market or Limit.">
    int

typeAlias PreTradeAnonymity_t: <"Allows trader to explicitly request anonymity or disclosure in pre-trade market data feeds. Anonymity is relevant in markets where counterparties are regularly disclosed in order depth feeds. Disclosure is relevant when counterparties are not normally visible.">
    Boolean

typeAlias PeggedRefPrice_t: <"The value of the reference price that the order is pegged to. PeggedRefPrice + PegOffsetValue (211) = PeggedPrice (839) unless the limit price (44, Price) is breached. The values may not be exact due to rounding.">
    Price

typeAlias PegSecurityID_t: <"Defines the identity of the security off whose prices the order will peg.">
    string

typeAlias PegSymbol_t: <"Defines the common, \'human understood\' representation of the security off whose prices the order will Peg.">
    string

typeAlias PegSecurityDesc_t: <"Security description of the security off whose prices the order will Peg.">
    string

typeAlias TriggerPrice_t: <"The price at which the trigger should hit.">
    Price

typeAlias TriggerSymbol_t: <"Defines the common, \'human understood\' representation of the security whose prices will be tracked by the trigger logic.">
    string

typeAlias TriggerSecurityID_t: <"Defines the identity of the security whose prices will be tracked by the trigger logic.">
    string

typeAlias TriggerSecurityDesc_t: <"Defines the security description of the security whose prices will be tracked by the trigger logic.">
    string

typeAlias TriggerNewPrice_t: <"The Price that the order should have after the trigger has hit. Could be applicable for any trigger type, but must be specified for Trigger Type 1.">
    Price

typeAlias TriggerNewQty_t: <"The Quantity the order should have after the trigger has hit.">
    Qty

typeAlias TriggerTradingSessionID_t: <"Defines the trading session at which the order will be activated.">
    string

typeAlias TriggerTradingSessionSubID_t: <"Defines the subordinate trading session at which the order will be activated.">
    string

typeAlias RootPartyID_t: <"PartyID value within a root parties component. Same values as PartyID (448)">
    string

typeAlias RootPartySubID_t: <"PartySubID value within a root parties component. Same values as PartySubID (523)">
    string

typeAlias OrigTradeDate_t: <"Used to preserve original trade date when original trade is being referenced in a subsequent trade transaction such as a transfer">
    LocalMktDate

typeAlias OrigTradeID_t: <"Used to preserve original trade id when original trade is being referenced in a subsequent trade transaction such as a transfer">
    string

typeAlias OrigSecondaryTradeID_t: <"Used to preserve original secondary trade id when original trade is being referenced in a subsequent trade transaction such as a transfer">
    string

typeAlias RefCstmApplVerID_t: <"Specifies a custom extension to a message being applied at the session level.">
    string

typeAlias TZTransactTime_t: <"Transact time in the local date-time stamp with a TZ offset to UTC identified">
    TZTimestamp

typeAlias ReportedPxDiff_t: <"Indicates that the reported price that is different from the market price. The price difference should be stated by using field 828 TrdType and, if required, field 829 TrdSubType">
    Boolean

typeAlias RptSys_t: <"Indicates the system or medium on which the report has been published">
    string

typeAlias AllocClearingFeeIndicator_t: <"ClearingFeeIndicator(635) for Allocation, see ClearingFeeIndicator(635) for permitted values.">
    string

typeAlias DisplayQty_t: <"The quantity to be displayed . Required for reserve orders. On orders specifies the qty to be displayed, on execution reports the currently displayed quantity.">
    Qty

typeAlias ExchangeSpecialInstructions_t: <"Free format text string related to exchange.">
    string

typeAlias MaxTradeVol_t: <"The maximum order quantity that can be submitted for a security.">
    Qty

typeAlias MatchAlgorithm_t: <"The types of algorithm used to match orders in a specific security. Possilbe value types are FIFO, Allocation, Pro-rata, Lead Market Maker, Currency Calender.">
    string

typeAlias MaxPriceVariation_t: <"The maximum price variation of an execution from one event to the next for a given security.">
    number

typeAlias EventTime_t: <"Specific time of event. To be used in combination with EventDate [866]">
    UTCTimestamp

typeAlias MinPriceIncrementAmount_t: <"Minimum price increment amount associated with the MinPriceIncrement ( tag 969). For listed derivatives, the value can be calculated by multiplying MinPriceIncrement by ContractValueFactor(231).">
    Amt

typeAlias UnitOfMeasureQty_t: <"Used to indicate the quantity of the underlying commodity unit of measure on which the contract is based, such as, 2500 lbs of lean cattle, 1000 barrels of crude oil, 1000 bushels of corn, etc. UnitOfMeasureQty is required for UnitOfMeasure(996) Variable Quantity UOMs enumerations. Refer to the definition of UnitOfMeasure(996) for more information on the use of UnitOfMeasureQty.">
    Qty

typeAlias LowLimitPrice_t: <"Allowable low limit price for the trading day. A key parameter in validating order price. Used as the lower band for validating order prices. Orders submitted with prices below the lower limit will be rejected">
    Price

typeAlias HighLimitPrice_t: <"Allowable high limit price for the trading day. A key parameter in validating order price. Used as the upper band for validating order prices. Orders submitted with prices above the upper limit will be rejected">
    Price

