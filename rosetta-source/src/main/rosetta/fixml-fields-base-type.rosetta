    string

typeAlias CFICode_t: <"Indicates the type of security using ISO 10962 standard, Classification of Financial Instruments (CFI code) values. ISO 10962 is maintained by ANNA (Association of National Numbering Agencies) acting as Registration Authority. See \"Appendix 6-B FIX Fields Based Upon Other Standards\". See also the Product (460) and SecurityType (167) fields. It is recommended that CFICode be used instead of SecurityType (167) for non-Fixed Income instruments. A subset of possible values applicable to FIX usage are identified in \"Appendix 6-D CFICode Usage - ISO 10962 Classification of Financial Instruments (CFI code)\"">
    string

typeAlias UnderlyingCFICode_t: <"Underlying security\'s CFICode. Valid values: see CFICode (461) field">
    string

typeAlias BookingRefID_t: <"Common reference passed to a post-trade booking process (e.g. industry matching utility).">
    string

typeAlias IndividualAllocID_t: <"Unique identifier for a specific NoAllocs (78) repeating group instance (e.g. for an AllocAccount).">
    string

