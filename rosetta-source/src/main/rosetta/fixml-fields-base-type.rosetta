typeAlias RegistID_t: <"Unique identifier of the registration details as assigned by institution or intermediary.">
    string

typeAlias ExecValuationPoint_t: <"For CIV - a date and time stamp to indicate the fund valuation point with respect to which a order was priced by the fund manager.">
    UTCTimestamp

typeAlias OrderPercent_t: <"For CIV specifies the approximate order quantity desired. For a CIV Sale it specifies percentage of investor\'s total holding to be sold. For a CIV switch/exchange it specifies percentage of investor\'s cash realised from sales to be re-invested. The executing broker, intermediary or fund manager is responsible for converting and calculating OrderQty (38) in shares/units for subsequent messages.">
