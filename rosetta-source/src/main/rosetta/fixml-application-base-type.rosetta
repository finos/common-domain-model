namespace cdm.fixml.application.base : < "test" >
version "${project.version}"

import cdm.fixml.components.base.*
import cdm.fixml.fields.base.*
import cdm.fixml.fields.impl.*

type ApplMsgReq extends ApplicationMessageRequest_message_t:

type ApplMsgReqAck extends ApplicationMessageRequestAck_message_t:

type ApplMsgRpt extends ApplicationMessageReport_message_t:

type ApplicationMessageRequest_message_t extends Abstract_message_t: <"ApplicationMessageRequest can be found in Volume 1 of the \t\t\t\t\t\tspecification">

    applReqID ApplReqID_t (1..1)
    applReqTyp ApplReqType_t (1..1)
    txt Text_t (0..1)
    encTxtLen EncodedTextLen_t (0..1)
    encTxt EncodedText_t (0..1)
    applIDReqGrp ApplIDRequestGrp_Block_t (0..*)
    pty Parties_Block_t (0..*)

type ApplicationMessageRequestAck_message_t extends Abstract_message_t: <"ApplicationMessageRequestAck can be found in Volume 1 of the \t\t\t\t\t\tspecification">

    applRespID ApplResponseID_t (1..1)
    applReqID ApplReqID_t (0..1)
    applReqTyp ApplReqType_t (0..1)
    applRespTyp ApplResponseType_t (0..1)
    applTotMsgCnt ApplTotalMessageCount_t (0..1)
    txt Text_t (0..1)
    encTxtLen EncodedTextLen_t (0..1)
    encTxt EncodedText_t (0..1)
    applIDReqAckGrp ApplIDRequestAckGrp_Block_t (0..*)
    pty Parties_Block_t (0..*)

type ApplicationMessageReport_message_t extends Abstract_message_t: <"ApplicationMessageReport can be found in Volume 1 of the \t\t\t\t\t\tspecification">

    applRptID ApplReportID_t (1..1)
    applReqID ApplReqID_t (0..1)
    applRptTyp ApplReportType_t (1..1)
    txt Text_t (0..1)
    encTxtLen EncodedTextLen_t (0..1)
    encTxt EncodedText_t (0..1)
    applIDRptGrp ApplIDReportGrp_Block_t (0..*)

type ApplIDRequestGrp_Block_t:

    refApplID RefApplID_t (0..1)
    refID RefApplReqID_t (0..1)
    applBegSeqNum ApplBegSeqNum_t (0..1)
    applEndSeq ApplEndSeqNum_t (0..1)
    pty NestedParties_Block_t (0..*)

type ApplIDRequestAckGrp_Block_t:

    refApplID RefApplID_t (0..1)
    refID RefApplReqID_t (0..1)
    applBegSeqNum ApplBegSeqNum_t (0..1)
    applEndSeq ApplEndSeqNum_t (0..1)
    refApplLastSeqNum RefApplLastSeqNum_t (0..1)
    applRespErr ApplResponseError_t (0..1)
    pty NestedParties_Block_t (0..*)

type ApplIDReportGrp_Block_t:

    refApplID RefApplID_t (0..1)
    applNewSeqNum ApplNewSeqNum_t (0..1)
    refApplLastSeqNum RefApplLastSeqNum_t (0..1)
