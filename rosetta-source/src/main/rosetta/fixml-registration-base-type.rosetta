namespace cdm.fixml.registration.base : < "test" >
version "${project.version}"

import cdm.fixml.components.base.*
import cdm.fixml.fields.base.*
import cdm.fixml.fields.impl.*

type RgstInstrctns extends RegistrationInstructions_message_t:

type RgstInstrctnsRsp extends RegistrationInstructionsResponse_message_t:

type RegistrationInstructions_message_t extends Abstract_message_t: <"RegistrationInstructions can be found in Volume 5 of the \t\t\t\t\t\tspecification">

    id RegistID_t (1..1)
    transTyp RegistTransType_t (1..1)
    refID RegistRefID_t (1..1)
    clOrdID ClOrdID_t (0..1)
    acct Account_t (0..1)
    acctIDSrc AcctIDSource_t (0..1)
    acctTyp RegistAcctType_t (0..1)
    taxAdvantageTyp TaxAdvantageType_t (0..1)
    ownershipTyp OwnershipType_t (0..1)
    pty Parties_Block_t (0..*)
    rgDtl RgstDtlsGrp_Block_t (0..*)
    rgDtlInst RgstDistInstGrp_Block_t (0..*)

type RegistrationInstructionsResponse_message_t extends Abstract_message_t: <"RegistrationInstructionsResponse can be found in Volume 5 of the \t\t\t\t\t\tspecification">

    id RegistID_t (1..1)
    transTyp RegistTransType_t (1..1)
    refID RegistRefID_t (1..1)
    clOrdID ClOrdID_t (0..1)
    acct Account_t (0..1)
    acctIDSrc AcctIDSource_t (0..1)
    regStat RegistStatus_t (1..1)
    rejRsnCd RegistRejReasonCode_t (0..1)
    dtls RegistRejReasonText_t (0..1)
    pty Parties_Block_t (0..*)

type RgstDistInstGrp_Block_t:

    distribPmtMethod DistribPaymentMethod_t (0..1)
    distribPctage DistribPercentage_t (0..1)
    cshDistribCurr CashDistribCurr_t (0..1)
    cshDistribAgentName CashDistribAgentName_t (0..1)
    cshDistribAgentCode CashDistribAgentCode_t (0..1)
    cshDistribAgentAcctNum CashDistribAgentAcctNumber_t (0..1)
    cshDistribPayRef CashDistribPayRef_t (0..1)
    cshDistribAgentAcctName CashDistribAgentAcctName_t (0..1)

type RgstDtlsGrp_Block_t:

    rejRsnTxt RegistDtls_t (0..1)
    email RegistEmail_t (0..1)
    mailingDtls MailingDtls_t (0..1)
    mailingInst MailingInst_t (0..1)
    ownerTyp OwnerType_t (0..1)
    dtOfBirth DateOfBirth_t (0..1)
    investorCtryOfResidence InvestorCountryOfResidence_t (0..1)
    pty NestedParties_Block_t (0..*)
