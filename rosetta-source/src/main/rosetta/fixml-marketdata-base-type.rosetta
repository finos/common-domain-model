type StrmAsgnRpt extends StreamAssignmentReport_message_t:

type StrmAsgnRptACK extends StreamAssignmentReportACK_message_t:

type MarketDataRequest_message_t extends Abstract_message_t: <"MarketDataRequest can be found in Volume 3 of the \t\t\t\t\t\tspecification">

    reqID MDReqID_t (1..1)
    subReqTyp SubscriptionRequestType_t (1..1)
    mktDepth MarketDepth_t (1..1)
    updtTyp MDUpdateType_t (0..1)
    aggBook AggregatedBook_t (0..1)
    openClsSettlFlag OpenCloseSettlFlag_t (0..1)
    scope Scope_t (0..1)
    implctDel MDImplicitDelete_t (0..1)
    applQuActn ApplQueueAction_t (0..1)
    applQuMax ApplQueueMax_t (0..1)
    mdQteTyp MDQuoteType_t (0..1)
    pty Parties_Block_t (0..*)
    req MDReqGrp_Block_t (1..*)
    instReq InstrmtMDReqGrp_Block_t (1..*)
    trdSes TrdgSesGrp_Block_t (0..*)

type MarketDataSnapshotFullRefresh_message_t extends Abstract_message_t: <"MarketDataSnapshotFullRefresh can be found in Volume 3 of the \t\t\t\t\t\tspecification">

